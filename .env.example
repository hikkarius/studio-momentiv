# =====================================================================
# AI Video Moments Analyzer Studio — Environment Variables Example
# Copy this file to .env and insert your real Gemini API key.
# =====================================================================

# Gemini API Key (Required for AI clip selection, virality scoring & hook generation)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional Server, Security & Logging Configuration
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# MAX_UPLOAD_BYTES=10737418240
# LOG_LEVEL=INFO
# LOG_FORMAT=text
